<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hospital" model="ir.module.category">
        <field name="name">Hospital</field>
        <field name="description">Hospital management access levels</field>
        <field name="sequence">40</field>
    </record>

    <record id="res_groups_privilege_hospital" model="res.groups.privilege">
        <field name="name">Hospital</field>
        <field name="category_id" ref="module_category_hospital"/>
    </record>

    <record id="group_hospital_receptionist" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="privilege_id" ref="res_groups_privilege_hospital"/>
    </record>

    <record id="group_hospital_doctor" model="res.groups">
        <field name="name">Doctor</field>
        <field name="privilege_id" ref="res_groups_privilege_hospital"/>
        <field name="implied_ids" eval="[(4, ref('group_hospital_receptionist'))]"/>
    </record>

    <record id="group_hospital_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_hospital"/>
        <field name="implied_ids" eval="[(4, ref('group_hospital_doctor'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Multi-company rules -->
    <record id="rule_hospital_patient_company" model="ir.rule">
        <field name="name">Patient: multi-company</field>
        <field name="model_id" ref="model_hospital_patient"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_hospital_appointment_company" model="ir.rule">
        <field name="name">Appointment: multi-company</field>
        <field name="model_id" ref="model_hospital_appointment"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Doctors only see their own appointments and prescriptions;
         managers see everything (group rules are OR-ed together). -->
    <record id="rule_hospital_appointment_doctor" model="ir.rule">
        <field name="name">Appointment: doctors see their own</field>
        <field name="model_id" ref="model_hospital_appointment"/>
        <field name="groups" eval="[(4, ref('group_hospital_doctor'))]"/>
        <field name="domain_force">[('doctor_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_hospital_appointment_manager" model="ir.rule">
        <field name="name">Appointment: managers see all</field>
        <field name="model_id" ref="model_hospital_appointment"/>
        <field name="groups" eval="[(4, ref('group_hospital_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_hospital_prescription_doctor" model="ir.rule">
        <field name="name">Prescription: doctors see their own</field>
        <field name="model_id" ref="model_hospital_prescription"/>
        <field name="groups" eval="[(4, ref('group_hospital_doctor'))]"/>
        <field name="domain_force">[('doctor_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_hospital_prescription_manager" model="ir.rule">
        <field name="name">Prescription: managers see all</field>
        <field name="model_id" ref="model_hospital_prescription"/>
        <field name="groups" eval="[(4, ref('group_hospital_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
