<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_department_list" model="ir.ui.view">
        <field name="name">hospital.department.list</field>
        <field name="model">hospital.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="head_doctor_id"/>
                <field name="doctor_count"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_department_form" model="ir.ui.view">
        <field name="name">hospital.department.form</field>
        <field name="model">hospital.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_doctors" type="object" class="oe_stat_button" icon="fa-user-md">
                            <field name="doctor_count" widget="statinfo" string="Doctors"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="head_doctor_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Doctors" name="doctors">
                            <field name="doctor_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="specialization"/>
                                    <field name="phone"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hospital_department_kanban" model="ir.ui.view">
        <field name="name">hospital.department.kanban</field>
        <field name="model">hospital.department</field>
        <field name="arch" type="xml">
            <kanban highlight_color="color">
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-4"/>
                        <div class="text-muted"><field name="code"/></div>
                        <div class="mt-2">
                            <i class="fa fa-user-md me-1" title="Doctors"/><field name="doctor_count"/> doctors
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_hospital_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">hospital.department</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first department</p>
        </field>
    </record>
</odoo>
