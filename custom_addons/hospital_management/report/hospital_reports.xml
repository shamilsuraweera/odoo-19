<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_prescription" model="ir.actions.report">
        <field name="name">Prescription</field>
        <field name="model">hospital.prescription</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hospital_management.report_prescription_document</field>
        <field name="report_file">hospital_management.report_prescription_document</field>
        <field name="print_report_name">'Prescription - %s' % (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="model_hospital_prescription"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_appointment_summary" model="ir.actions.report">
        <field name="name">Appointment Summary</field>
        <field name="model">hospital.appointment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hospital_management.report_appointment_summary_document</field>
        <field name="report_file">hospital_management.report_appointment_summary_document</field>
        <field name="print_report_name">'Appointments'</field>
        <field name="binding_model_id" ref="model_hospital_appointment"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
