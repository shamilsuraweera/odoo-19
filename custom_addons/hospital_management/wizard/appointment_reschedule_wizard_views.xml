<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_appointment_reschedule_wizard_form" model="ir.ui.view">
        <field name="name">hospital.appointment.reschedule.wizard.form</field>
        <field name="model">hospital.appointment.reschedule.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="appointment_id"/>
                    <field name="new_start"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_reschedule" string="Reschedule" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
